{
  "name": "deskflow",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "setup": "npm run db:migrate && npm run db:seed",
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "npm run start -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:demo": "npm run db:demo -w server",
    "db:reset": "npm run db:reset -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test -w server && npm run test -w client",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "user:reset-password": "npm run user:reset-password -w server --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "concurrently": "^9.2.5",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
