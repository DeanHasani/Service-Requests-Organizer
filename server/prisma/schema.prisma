generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; rhel-openssl-3.0.x for Vercel functions.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  MANAGER
  EMPLOYEE
}

enum Status {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum Category {
  HARDWARE
  SOFTWARE
  NETWORK
  ACCESS
  FACILITIES
  OTHER
}

enum Source {
  PHONE
  EMAIL
  MESSAGE
  OTHER
}

enum ActionType {
  CREATED
  UPDATED
  PRIORITY_CHANGED
  ASSIGNED
  REASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  RESOLVED
  REOPENED
  DEADLINE_CHANGED
  /// Written by the deadline monitor (no human actor).
  DEADLINE_APPROACHING
  DEADLINE_OVERDUE
  PRIORITY_ESCALATED
  PRIORITY_RESTORED
}

/// Where a request stands against its deadline; separate from its lifecycle status.
enum DeadlineState {
  ON_TRACK
  APPROACHING
  OVERDUE
  COMPLETED
}

enum NotificationType {
  /// A request was assigned to you.
  ASSIGNED
  /// Deadline close and nobody owns the request (managers).
  DEADLINE_UNASSIGNED
  /// Deadline close, assigned but still Open (assignee and managers).
  DEADLINE_NOT_STARTED
  /// Deadline close, in progress (assignee and managers).
  DEADLINE_IN_PROGRESS
  /// Deadline passed, not resolved (assignee and managers).
  DEADLINE_OVERDUE
}

model User {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role      @default(EMPLOYEE)
  isActive           Boolean   @default(true)
  /// Set when a manager resets the password; cleared once the user picks their own.
  mustChangePassword Boolean   @default(false)
  /// Set when a manager deletes the account: it can never sign in again and leaves the team
  /// lists, but its name stays on the work it did. The email is freed for reuse.
  deletedAt          DateTime?
  deletedById        Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignedRequests Request[]      @relation("Assignee")
  createdRequests  Request[]      @relation("Creator")
  resolvedRequests Request[]      @relation("Resolver")
  notifications    Notification[]
  notes            RequestNote[]
  activities       ActivityLog[]
  sessions         Session[]
  deletedBy        User?          @relation("DeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  deletedUsers     User[]         @relation("DeletedBy")
}

model Request {
  id                Int            @id @default(autoincrement())
  referenceNumber   String         @unique
  /// Idempotency key from the client; a retried create returns the existing row.
  clientRequestId   String         @unique
  title             String
  description       String
  requesterName     String
  requesterContact  String
  source            Source
  /// What kind of issue it is. Null for requests logged before categories existed.
  category          Category?
  priority          Priority       @default(NORMAL)
  /// LOW=0 … URGENT=3. Lets the list sort by urgency instead of alphabetically.
  priorityRank      Int            @default(1)
  status            Status         @default(OPEN)
  /// Optimistic concurrency token, bumped on every write.
  version           Int            @default(0)
  assignedToId      Int?
  createdById       Int
  resolvedById      Int?
  resolvedAt        DateTime?
  /// Deadline set by a manager.
  dueAt             DateTime?
  /// Optional minimum set by a manager: when the deadline gets close, the operational
  /// priority rises to at least this level.
  escalateTo        Priority?
  /// Operational priority raised by the deadline monitor; null when not escalated. `priority`
  /// always keeps the priority people chose. Effective priority = escalatedPriority ?? priority.
  escalatedPriority Priority?
  /// When the current escalation happened.
  escalatedAt       DateTime?
  /// Deadline status kept by the monitor; null when there is no deadline.
  deadlineState     DeadlineState?
  /// Bumped when the deadline changes or the request is reopened, so reminders can be sent
  /// again for the new situation. Part of the notification de-duplication key.
  deadlineCycle     Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  assignedTo    User?          @relation("Assignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdBy     User           @relation("Creator", fields: [createdById], references: [id], onDelete: Restrict)
  resolvedBy    User?          @relation("Resolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  notes         RequestNote[]
  activities    ActivityLog[]
  notifications Notification[]

  @@index([status])
  @@index([assignedToId, status])
  @@index([priorityRank])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([dueAt])
  @@index([category])
  @@index([deadlineState])
}

model RequestNote {
  id        Int      @id @default(autoincrement())
  requestId Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

model ActivityLog {
  id          Int        @id @default(autoincrement())
  requestId   Int
  /// Null for automatic events (the deadline monitor).
  actorId     Int?
  actionType  ActionType
  fieldName   String?
  oldValue    String?
  newValue    String?
  description String
  createdAt   DateTime   @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([createdAt])
}

/// In-app notification for one person. `dedupeKey` is unique, so the same reminder for the same
/// request, person, stage and deadline cycle can never be created twice, even across restarts.
model Notification {
  id          Int              @id @default(autoincrement())
  recipientId Int
  requestId   Int?
  type        NotificationType
  /// Deadline stage it belongs to (approaching_unassigned, overdue, ...), when it is a reminder.
  stage       String?
  title       String
  message     String
  dedupeKey   String           @unique
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  recipient User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  request   Request? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
}

/// Server-side session. `id` is the SHA-256 of the cookie token, never the token itself.
model Session {
  id        String   @id
  userId    Int
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Monotonic counters. `request` drives SR-000001 style reference numbers.
model Counter {
  name  String @id
  value Int
}
