generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  EMPLOYEE
}

enum Status {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum Source {
  PHONE
  EMAIL
  MESSAGE
  OTHER
}

enum ActionType {
  CREATED
  UPDATED
  PRIORITY_CHANGED
  ASSIGNED
  REASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  RESOLVED
  REOPENED
  DEADLINE_CHANGED
}

model User {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role      @default(EMPLOYEE)
  isActive           Boolean   @default(true)
  /// Set when a manager resets the password; cleared once the user picks their own.
  mustChangePassword Boolean   @default(false)
  /// Set when a manager deletes the account: it can never sign in again and leaves the team
  /// lists, but its name stays on the work it did. The email is freed for reuse.
  deletedAt          DateTime?
  deletedById        Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignedRequests Request[]     @relation("Assignee")
  createdRequests  Request[]     @relation("Creator")
  resolvedRequests Request[]     @relation("Resolver")
  escalationRules  Request[]     @relation("Escalation")
  notes            RequestNote[]
  activities       ActivityLog[]
  sessions         Session[]
  deletedBy        User?         @relation("DeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  deletedUsers     User[]        @relation("DeletedBy")
}

model Request {
  id               Int       @id @default(autoincrement())
  referenceNumber  String    @unique
  /// Idempotency key from the client; a retried create returns the existing row.
  clientRequestId  String    @unique
  title            String
  description      String
  requesterName    String
  requesterContact String
  source           Source
  priority         Priority  @default(NORMAL)
  /// LOW=0 … URGENT=3. Lets the list sort by urgency instead of alphabetically.
  priorityRank     Int       @default(1)
  status           Status    @default(OPEN)
  /// Optimistic concurrency token, bumped on every write.
  version          Int       @default(0)
  assignedToId     Int?
  createdById      Int
  resolvedById     Int?
  resolvedAt       DateTime?
  /// Deadline set by a manager.
  dueAt            DateTime?
  /// Optional rule set by a manager: once the deadline is under 24 hours away, raise the
  /// priority to this level (only ever upward). `escalatedAt` records that it has run.
  escalateTo       Priority?
  escalatedAt      DateTime?
  /// The manager who set the rule; the automatic change is recorded in their name.
  escalationById   Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  assignedTo   User?         @relation("Assignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdBy    User          @relation("Creator", fields: [createdById], references: [id], onDelete: Restrict)
  resolvedBy   User?         @relation("Resolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  escalationBy User?         @relation("Escalation", fields: [escalationById], references: [id], onDelete: Restrict)
  notes        RequestNote[]
  activities   ActivityLog[]

  @@index([status])
  @@index([assignedToId, status])
  @@index([priorityRank])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([dueAt])
}

model RequestNote {
  id        Int      @id @default(autoincrement())
  requestId Int
  authorId  Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
}

model ActivityLog {
  id          Int        @id @default(autoincrement())
  requestId   Int
  actorId     Int
  actionType  ActionType
  fieldName   String?
  oldValue    String?
  newValue    String?
  description String
  createdAt   DateTime   @default(now())

  request Request @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([createdAt])
}

/// Server-side session. `id` is the SHA-256 of the cookie token, never the token itself.
model Session {
  id        String   @id
  userId    Int
  csrfToken String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Monotonic counters. `request` drives SR-000001 style reference numbers.
model Counter {
  name  String @id
  value Int
}
