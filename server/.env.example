# Postgres (Supabase). DATABASE_URL is what the app uses; DIRECT_URL is for migrations.
# Live (Vercel): DATABASE_URL = transaction pooler (port 6543) with ?pgbouncer=true&connection_limit=1
#                DIRECT_URL   = session pooler (port 5432)
# Local: both can be the session pooler with ?schema=dev so local data stays separate.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?schema=dev&connection_limit=5"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?schema=dev"
# Base connection for the test suites (they use their own schemas: "test", "e2e").
TEST_DATABASE_BASE="postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"
PORT=4000
NODE_ENV=development
# Session lifetime in hours (slides forward while in use)
SESSION_TTL_HOURS=8
# Password used by the seed script for every demo account
SEED_PASSWORD="Deskflow!2026"
# Secret the scheduled jobs send in the Authorization header (Bearer ...)
CRON_SECRET="change-me"
